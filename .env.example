# Copiez ce fichier en ".env" puis collez UNE clé après le signe =  (ne partagez jamais ce fichier)

# Option 1 — Gemini (Google). Clé à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Facultatif : forcer un modèle (sinon le Flash le plus récent est choisi automatiquement)
# GEMINI_MODEL=gemini-2.5-flash

# Option 2 — Claude (Anthropic). Clé à créer sur https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5

# Si les deux clés sont présentes, choisissez : gemini ou claude
# AI_PROVIDER=gemini
